<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>عمور - مونتير يوتيوب</title>
  <style>
    body {
      margin: 0;
      font-family: 'Cairo', sans-serif;
      background-color: #111;
      color: #fff;
    }
    header {
      background-color: #1e1e1e;
      padding: 20px;
      text-align: center;
      font-size: 24px;
      font-weight: bold;
    }
    .section {
      padding: 40px 20px;
      text-align: center;
    }
    .section h2 {
      margin-bottom: 20px;
      font-size: 28px;
      color: #ff4c60;
    }
    .bio {
      max-width: 600px;
      margin: 0 auto;
      font-size: 18px;
      line-height: 1.6;
    }
    .videos iframe {
      width: 100%;
      max-width: 400px;
      height: 225px;
      margin: 15px;
      border-radius: 8px;
    }
    .social {
      margin-top: 30px;
    }
    .social a {
      color: #fff;
      background: #ff4c60;
      padding: 10px 20px;
      border-radius: 30px;
      text-decoration: none;
      font-size: 16px;
      transition: background 0.3s;
    }
    .social a:hover {
      background: #e63b50;
    }
  </style>
</head>
